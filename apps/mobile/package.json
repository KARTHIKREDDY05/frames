{
  "name": "@frames/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/patch-seo.mjs",
    "build:android": "eas build --platform android --profile production",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "configure:oauth": "node scripts/configure-supabase-oauth.mjs",
    "configure:oauth:google": "node scripts/configure-supabase-google-oauth.mjs",
    "submit:android": "eas submit --platform android --profile production",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.3",
    "@frames/types": "workspace:*",
    "@frames/ui": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.51.23",
    "expo": "^52.0.0",
    "expo-camera": "^15.0.15",
    "expo-contacts": "~13.0.5",
    "expo-font": "~12.0.10",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "^15.0.7",
    "expo-linear-gradient": "^13.0.2",
    "expo-location": "^17.0.1",
    "expo-notifications": "^0.28.18",
    "expo-router": "^3.5.23",
    "expo-secure-store": "^13.0.2",
    "expo-splash-screen": "~0.27.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.75.5",
    "react-native-gesture-handler": "^2.16.2",
    "react-native-reanimated": "3.10.1",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "^3.31.1",
    "react-native-web": "~0.19.10",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "eas-cli": "^22.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.4",
    "typescript": "^5.5.4"
  }
}
