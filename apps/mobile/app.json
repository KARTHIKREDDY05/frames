{
  "expo": {
    "name": "Frames",
    "slug": "frames",
    "scheme": "frames",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F0E7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Frames uses the camera so you can capture real moments for your daily frame."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Frames uses your photo library so you can choose existing photos and videos for your frame."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Frames uses your contacts so you can find friends and invite people to download the app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Frames uses your location to attach a capture place to your Frame when you allow it."
        }
      ]
    ],
    "owner": "taehabeom",
    "runtimeVersion": "1.0.0",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ab4bf3f3-1c17-4513-8943-7afc5ec68d18"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Frames",
      "shortName": "Frames",
      "themeColor": "#F6F0E7",
      "backgroundColor": "#F6F0E7",
      "description": "Frames is a social scrapbook app for capturing daily moments, following friends, and turning posts into memories."
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.frames.mobile"
    },
    "android": {
      "package": "app.frames.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F0E7"
      },
      "playStoreUrl": "https://play.google.com/store/apps/details?id=app.frames.mobile"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ab4bf3f3-1c17-4513-8943-7afc5ec68d18"
      }
    }
  }
}
